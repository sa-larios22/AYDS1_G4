// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  PERSONAL
}

model User {
  id Int @id @default(autoincrement())

  name     String
  lastname String

  username String @unique
  email    String @unique
  password String

  active Boolean @default(true)

  role Role @default(USER)

  tickets Ticket[]

  payments Payment[]
}

model Gate {
  id   Int    @id @default(autoincrement())
  name String

  flights Flight[]
}

enum Status {
  SCHEDULED
  AT_GATE
  LANDED
}

model Flight {
  id Int @id @default(autoincrement())

  origin      String
  destination String

  departure DateTime
  arrival   DateTime
  price     Float
  status    Status   @default(SCHEDULED)
  maxPassengers Int
  soldTickets Int

  GateId Int?
  gate Gate? @relation(fields: [GateId], references: [id])

  tickets Ticket[]

}

enum TicketStatus {
  SOLD
  AVAILABLE
}

enum TicketType {
  ECONOMY
  BUSINESS
  FIRST_CLASS
}

model Ticket {
  id Int @id @default(autoincrement())

  status TicketStatus @default(SOLD)

  type TicketType @default(ECONOMY)

  flightId Int
  flight Flight @relation(fields: [flightId], references: [id])

  userId Int
  user User @relation(fields: [userId], references: [id])

  payment Payment?
}

enum PaymentType {
  CASH
  CREDIT_CARD
  DEBIT_CARD
}

model Payment {
  id Int @id @default(autoincrement())

  amount Float
  date   DateTime

  type PaymentType @default(CASH)

  userId Int
  user User @relation(fields: [userId], references: [id])

  ticketId Int @unique
  ticket Ticket @relation(fields: [ticketId], references: [id])
}